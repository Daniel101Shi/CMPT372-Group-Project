# copy this to .env and fill it in. the real .env is gitignored.
#   cp .env.example .env

POSTGRES_USER=backendAPI
POSTGRES_PASSWORD=topsecretsecret
POSTGRES_DB=lopo_db
POSTGRES_PORT=5432
# localhost when running the backend outside docker, "postgres" when inside compose
POSTGRES_HOST=localhost

# signs the session cookie. generate your own with:
#   openssl rand -hex 32
# the backend refuses to start without this when NODE_ENV=production
SESSION_SECRET=replace-me-with-a-random-string

# where the frontend runs, for the cors allowlist
CLIENT_URL=http://localhost:5173
